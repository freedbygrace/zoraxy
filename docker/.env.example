# Zoraxy Docker Environment Variables
# Copy this file to .env and customize as needed

###BEGIN GENERAL###
STACK_NAME=EdgeLoadBalancer
TZ=America/New_York
UID=0
GID=0
# Management interface port (internal)
PORT=8000
# Database backend (auto, leveldb, boltdb)
DB=auto
# Enable system-wide logging
ENABLELOG=true
# Enable high-speed GeoIP lookup (requires ~1GB extra memory)
FASTGEOIP=false
###END GENERAL###

###BEGIN BOOTSTRAP###
# Admin username (created on first startup if set)
ZORAXY_ADMIN_USER=admin
# Admin password (created on first startup if set)
ZORAXY_ADMIN_PASSWORD=
# Create /admin/ virtual directory for UI access via reverse proxy
ZORAXY_BOOTSTRAP_UI=true
###END BOOTSTRAP###

###BEGIN CLUSTER###
# Enable cluster mode for multi-node sync
CLUSTER=true
# Shared secret for cluster authentication
# Generate with: openssl rand -base64 32
CLUSTER_SECRET=
# Comma-separated list of peer URLs (for manual peer configuration)
# Example: http://node2:8000,http://node3:8000
CLUSTER_PEERS=
###END CLUSTER###

###BEGIN SWARM###
# Enable Docker Swarm peer auto-discovery
CLUSTER_SWARM=true
# DNS name for Swarm service discovery
# Format: tasks.<stack-name>_<service-name>
CLUSTER_SWARM_SERVICE=tasks.EdgeLoadBalancer_zoraxy
# Port for Swarm peer communication
CLUSTER_SWARM_PORT=8000
# Scheme for Swarm peer URLs (http or https)
CLUSTER_SWARM_SCHEME=http
###END SWARM###

###BEGIN CERTIFICATES###
# ACME auto-renewal check interval (seconds)
AUTORENEW=86400
# Days before expiry to renew certificates
EARLYRENEW=30
###END CERTIFICATES###

###BEGIN MDNS###
# Enable mDNS scanner and transponder
MDNS=true
# Custom mDNS name (leave empty for default: zoraxy_{node-uuid}.local)
MDNSNAME=
###END MDNS###

###BEGIN SECURITY###
# Disable authentication for management interface (DANGER - use with external auth only)
NOAUTH=false
# Allow loopback web SSH connections (DANGER - for testing only)
SSHLB=false
###END SECURITY###

###BEGIN WEBSERVER###
# Enable web file manager for static web server root
WEBFM=true
# Static web server root folder
WEBROOT=./www
###END WEBSERVER###

###BEGIN ZEROTIER###
# Enable ZeroTier functionality for GAN (requires NET_ADMIN and /dev/net/tun)
ZEROTIER=false
###END ZEROTIER###

###BEGIN PLUGINS###
# Plugin folder path
PLUGIN=/opt/zoraxy/plugin/
###END PLUGINS###

